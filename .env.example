# App Server
PORT=3000
NODE_ENV=development
# Optional product JSON directory; defaults to this project's products/ folder.
# PRODUCTS_DIR=./products

# Post Sourcing Provider: scraper | mock
POST_SOURCE_PROVIDER=scraper

# Scraper Configuration:
# 1. Apify Free Tier Actor (Recommended, e.g. burbn~threads-search-scraper)
APIFY_TOKEN=
APIFY_ACTOR=burbn~threads-search-scraper

# 2. Or Custom Scraper Microservice (e.g. RapidAPI, local Python/Botasaurus scraper)
# SCRAPER_ENDPOINT=https://api.apify.com/v2/acts/.../run-sync-get-dataset-items
# SCRAPER_API_KEY=

# Database Adapter: sqlite | memory (defaults to sqlite)
DB_ADAPTER=sqlite

# Mock mode: set to true to test sourcing, AI draft generation, and Web Intent locally without API limits
USE_MOCK_POSTS=false

# AI Provider Configuration (OpenAI, Groq, Gemini, OpenRouter compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Schedulers
# Cron schedule for checking keywords across campaigns (e.g. every 20 minutes)
CRON_SCHEDULE=*/20 * * * *
