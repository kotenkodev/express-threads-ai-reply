# App Server
PORT=3000
NODE_ENV=development
# Optional product JSON directory; defaults to this project's products/ folder.
# PRODUCTS_DIR=./products
# Optional: full path to cloudflared if it is not on PATH (used by npm run tunnel)
# CLOUDFLARED_PATH=C:/tools/cloudflared.exe
# TUNNEL_PROVIDER=cloudflare
# NGROK_PATH=C:/tools/ngrok.exe
# For ngrok, get your token from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

# Safe mode: when true, processes posts & generates AI replies, logs them to DB/console, but does not publish to Threads
DRY_RUN=true

# Post Sourcing Provider: threads_api | scraper | mock
POST_SOURCE_PROVIDER=threads_api

# Optional 3rd-party scraper configuration (e.g. Apify / RapidAPI / Custom webhook)
# SCRAPER_ENDPOINT=https://api.apify.com/v2/acts/.../run-sync-get-dataset-items
# SCRAPER_API_KEY=

# Database Adapter: memory | sqlite (defaults to memory)
DB_ADAPTER=memory

# Mock mode: set to true to test AI replies, queueing, and dashboard locally without Meta API 403 restrictions
USE_MOCK_POSTS=false

# AI Provider Configuration (OpenAI, Groq, Gemini, OpenRouter compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Schedulers
# Cron schedule for checking keywords across campaigns (e.g. every 15 minutes)
CRON_SCHEDULE=*/15 * * * *

# Meta Threads App Credentials (for OAuth login flow)
THREADS_APP_ID=
THREADS_APP_SECRET=
REDIRECT_URI=https://<your-subdomain>.ngrok-free.app/callback

# Optional 3rd-party scraper configuration (Apify burbn~threads-search-scraper)
APIFY_TOKEN=
APIFY_ACTOR=burbn~threads-search-scraper

# Threads API tokens for configured campaigns
THREADS_ACCESS_TOKEN=your_threads_access_token_here
# Add one variable per product's publishing.credentialVariable, e.g.:
# THREADS_TOKEN_BRIEFGARDEN=your_threads_token
# Add a variable for generation.credentialVariable if a product uses another AI account.

