# App Server
PORT=3000
NODE_ENV=development

# Post Sourcing Provider: scraper | mock
POST_SOURCE_PROVIDER=scraper

# Database Adapter: sqlite | memory
DB_ADAPTER=sqlite

# Apify Scraper Configuration
APIFY_TOKEN=
APIFY_ACTOR=burbn~threads-search-scraper

# Optional Custom Scraper Microservice (e.g. RapidAPI, custom scraper)
# SCRAPER_ENDPOINT=
# SCRAPER_API_KEY=

# AI Provider Configuration (OpenAI, Groq, Gemini, OpenRouter compatible)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
